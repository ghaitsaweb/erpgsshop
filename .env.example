ERP_PORT=8010
POSTGRES_DB=erp_gsshop
POSTGRES_USER=erp_gsshop
POSTGRES_PASSWORD=change-this-database-password
DJANGO_SECRET_KEY=change-this-django-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8010,http://127.0.0.1:8010
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@gsshop.local
DJANGO_SUPERUSER_PASSWORD=change-this-admin-password
SEED_DEMO=True
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
GSSHOP_ADDONS_PATHS=/app/addons
